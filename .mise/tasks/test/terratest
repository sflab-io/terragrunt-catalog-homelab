#!/usr/bin/env bash

set -o pipefail

#USAGE flag "-d --dir <dir>" help="Unterverzeichnis der Tests (z.B. 'tofu' oder 'terragrunt/units')"
#USAGE flag "-n --name <name>" help="Func-Name eines einzelnen Tests (z.B. 'TestModuleNaming')"
#USAGE flag "-f --force" help="Test-Cache umgehen und Tests immer neu ausführen"

TEST_ROOT="$(git rev-parse --show-toplevel)/test"
CACHE_FLAG=""
[ "$usage_force" = "true" ] && CACHE_FLAG="-count=1"

if [ -n "$usage_dir" ] && [ -n "$usage_name" ]; then
  echo "Fehler: --dir und --name können nicht gleichzeitig verwendet werden." >&2
  exit 1
fi

TMPFILE=$(mktemp)
trap 'rm -f "$TMPFILE"' EXIT

cd "$TEST_ROOT"

TEST_EXIT=0
if [ -n "$usage_name" ]; then
  echo "=== Führe Test '$usage_name' aus (alle Verzeichnisse) ==="
  go test -v -timeout 30m $CACHE_FLAG -run "$usage_name" ./... 2>&1 | tee "$TMPFILE"
  TEST_EXIT=${PIPESTATUS[0]}
elif [ -n "$usage_dir" ]; then
  TARGET="$TEST_ROOT/$usage_dir"
  if [ ! -d "$TARGET" ]; then
    echo "Fehler: Verzeichnis '$TARGET' existiert nicht." >&2
    exit 1
  fi
  echo "=== Führe Tests in '$usage_dir' aus ==="
  go test -v -timeout 30m $CACHE_FLAG "./$usage_dir/..." 2>&1 | tee "$TMPFILE"
  TEST_EXIT=${PIPESTATUS[0]}
else
  echo "=== Führe alle Tests aus ==="
  go test -v -timeout 30m $CACHE_FLAG ./... 2>&1 | tee "$TMPFILE"
  TEST_EXIT=${PIPESTATUS[0]}
fi

# Testergebnisse aus der Ausgabe parsen (Subtests haben führende Leerzeichen)
PASSED_TESTS=()
FAILED_TESTS=()

while IFS= read -r line; do
  if [[ "$line" =~ ^[[:space:]]*---[[:space:]]PASS:[[:space:]]([^[:space:]]+) ]]; then
    PASSED_TESTS+=("${BASH_REMATCH[1]}")
  elif [[ "$line" =~ ^[[:space:]]*---[[:space:]]FAIL:[[:space:]]([^[:space:]]+) ]]; then
    FAILED_TESTS+=("${BASH_REMATCH[1]}")
  fi
done < "$TMPFILE"

# Prüfen ob Subtests vorhanden sind (Format: TestAll/SubtestName)
HAS_SUBTESTS=false
for t in "${PASSED_TESTS[@]}" "${FAILED_TESTS[@]}"; do
  if [[ "$t" == */* ]]; then
    HAS_SUBTESTS=true
    break
  fi
done

# Nur den Subtest-Namen anzeigen, Parent-Tests (z.B. TestAll) überspringen wenn Subtests existieren
format_tests() {
  for t in "$@"; do
    if $HAS_SUBTESTS && [[ "$t" != */* ]]; then
      continue  # Parent-Test überspringen
    fi
    echo "${t#*/}"  # TestAll/ Präfix entfernen
  done
}

PASSED_DISPLAY=()
while IFS= read -r line; do
  [[ -n "$line" ]] && PASSED_DISPLAY+=("$line")
done < <(format_tests "${PASSED_TESTS[@]}")

FAILED_DISPLAY=()
while IFS= read -r line; do
  [[ -n "$line" ]] && FAILED_DISPLAY+=("$line")
done < <(format_tests "${FAILED_TESTS[@]}")

PASS_COUNT=${#PASSED_DISPLAY[@]}
FAIL_COUNT=${#FAILED_DISPLAY[@]}
TOTAL=$((PASS_COUNT + FAIL_COUNT))

echo ""
echo "========================================"
echo "           Test-Übersicht"
echo "========================================"
echo ""

if [ "$TOTAL" -eq 0 ]; then
  echo "  Keine Testergebnisse (ggf. alle gecacht — benutze -f um Cache zu umgehen)."
else
  if [ "$PASS_COUNT" -gt 0 ]; then
    echo "ERFOLGREICH ($PASS_COUNT):"
    for test in "${PASSED_DISPLAY[@]}"; do
      echo "  + $test"
    done
    echo ""
  fi

  if [ "$FAIL_COUNT" -gt 0 ]; then
    echo "FEHLGESCHLAGEN ($FAIL_COUNT):"
    for test in "${FAILED_DISPLAY[@]}"; do
      echo "  - $test"
    done
    echo ""
  fi
fi

echo "========================================"

exit "$TEST_EXIT"
